<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HotelBooking">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.auth.RegisterActivity" android:exported="false" />

        <activity android:name=".ui.user.RoomListActivity" android:exported="false" />
        <activity android:name=".ui.user.BookingActivity" android:exported="false" />
        <activity android:name=".ui.user.PaymentActivity" android:exported="false" />
        <activity android:name=".ui.user.MyBookingsActivity" android:exported="false" />

        <activity android:name=".ui.admin.AdminHomeActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminBookingsActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminRoomsActivity" android:exported="false" />
        <activity android:name=".ui.admin.AddRoomActivity" android:exported="false" />
    </application>
</manifest>
